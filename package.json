{
  "name": "alenote",
  "productName": "AleNote",
  "version": "1.6.0",
  "description": "AleNote – moderne, erweiterbare Notiz-App im Stil von Obsidian/Notion",
  "main": "main.js",
  "author": "AleNote",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "android:sync": "node -e \"require('fs').copyFileSync('node_modules/@capacitor/core/dist/index.js','src/vendor/capacitor-core.js')\" && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/status-bar": "^8.0.4",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.alenote.app",
    "productName": "AleNote",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "sync.js",
      "updater.js",
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AleNote",
      "artifactName": "AleNote-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "AleNote-Portable-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AleB-Roni",
        "repo": "AleNote"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AleB-Roni/AleNote.git"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
