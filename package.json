{
  "name": "alenote",
  "productName": "AleNote",
  "version": "1.0.0",
  "description": "AleNote – moderne, erweiterbare Notiz-App im Stil von Obsidian/Notion",
  "main": "main.js",
  "author": "AleNote",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.alenote.app",
    "productName": "AleNote",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "sync.js",
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AleNote",
      "artifactName": "AleNote-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "AleNote-Portable-${version}.exe"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AleB-Roni/AleNote.git"
  }
}
